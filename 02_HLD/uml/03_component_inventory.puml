skinparam EntityBackgroundColor #FFFFFF
skinparam EntityBorderColor #2B50D6

title Component Diagram — Inventory & Reservation Service
left to right direction

component "API Gateway" as GW
database "Redis" as R
database "Inventory DB\n(PostgreSQL)" as DB
queue "Kafka" as K

package "Inventory & Reservation Service" {
  component "ReservationController" as CTRL
  component "RequestValidator" as VAL
  component "IdempotencyGuard" as IDEM
  component "ReservationService\n<<application service>>" as RS
  component "AdmissionGate\n<<Redis Lua>>" as GATE
  interface "ReservationStrategy" as RSI
  component "AtomicConditionalUpdate\n<<selected strategy>>" as ACU
  component "InventoryRepository\n<<Repository>>" as REPO
  component "ReservationRepository\n<<Repository>>" as RREPO
  component "ReservationStateMachine\n<<State>>" as SM
  component "OutboxWriter" as OB
  component "ExpirySweeper\n<<scheduled>>" as SW
  component "PaymentEventConsumer\n<<idempotent>>" as PEC
}

GW --> CTRL : POST /reservations
CTRL --> VAL
VAL --> IDEM
IDEM --> RS
IDEM ..> R : SET NX
RS --> GATE
GATE ..> R : EVAL decr_if_enough
RS --> RSI
ACU ..|> RSI
RSI ..> REPO
RS --> RREPO
RS --> SM
RS --> OB
SW --> RS : expireStale()
K --> PEC : PaymentSucceeded\nPaymentFailed\nOrderConfirmed
PEC --> RS
REPO ..> DB
RREPO ..> DB
OB ..> DB : same transaction
note bottom of ACU
  UPDATE inventory
  SET available = available - 1 ...
  WHERE available >= 1
  -- consistency point
end note

@enduml
