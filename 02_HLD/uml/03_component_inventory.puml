skinparam ArrowFontColor #4B5669
skinparam ArrowFontSize 11
skinparam TitleFontSize 16
skinparam TitleFontStyle bold
skinparam NoteBackgroundColor #FFF4E0
skinparam NoteBorderColor #B26B00
skinparam NoteFontColor #142033
skinparam ClassBackgroundColor #FFFFFF
skinparam ClassBorderColor #2B50D6
skinparam ClassHeaderBackgroundColor #EAEFFF
skinparam ClassAttributeIconSize 0
skinparam StereotypeCBackgroundColor #EAEFFF
skinparam InterfaceBackgroundColor #FFFFFF
skinparam ParticipantBackgroundColor #EAEFFF
skinparam ParticipantBorderColor #2B50D6
skinparam ActorBackgroundColor #EAEFFF
skinparam ActorBorderColor #2B50D6
skinparam DatabaseBackgroundColor #F4F6F9
skinparam DatabaseBorderColor #4B5669
skinparam QueueBackgroundColor #FFF4E0
skinparam QueueBorderColor #B26B00
skinparam SequenceLifeLineBorderColor #CFD6E0
skinparam SequenceGroupBorderColor #CFD6E0
