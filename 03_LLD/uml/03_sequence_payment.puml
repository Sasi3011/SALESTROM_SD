title Sequence — Payment (success, decline, timeout, circuit open)
autonumber
actor Customer as C
participant "Checkout\n<<Facade>>" as CK
participant "Inventory\nservice" as INV
participant "Payment\nservice" as PAY
participant "Circuit\nbreaker" as CB
participant "External PSP" as PSP
queue "Outbox → Kafka" as K

C -> CK : POST /checkout/payments {reservationId}\nIdempotency-Key: p1
CK -> CK : idempotency check p1\n(duplicate Pay waits / replays)
CK -> INV : startPayment(reservationId)
note right of INV
  UPDATE reservation SET status = 'PAYMENT_PENDING'
  WHERE id = ? AND status = 'RESERVED' AND expires_at > now()
end note
alt hold expired or not owned
  INV --> CK : false
  CK --> C : 410 RESERVATION_EXPIRED
end
CK -> K : CheckoutStarted (order draft)
CK -> PAY : charge(reservationId)
PAY -> PAY : INSERT payment\nidempotency_key = pay_{reservationId} (UNIQUE)
PAY -> CB : call()
alt circuit OPEN
  CB --> PAY : fail fast (PSP not called)
  PAY --> CK : UNAVAILABLE
  CK -> INV : resumeHold (back to RESERVED)
  CK --> C : 503 PAYMENT_UNAVAILABLE, Retry-After: 2
else circuit CLOSED / HALF_OPEN
  CB -> PSP : POST /charges\nIdempotency-Key: pay_{reservationId} (timeout 3 s)
  alt approved
    PSP --> PAY : SUCCEEDED (txn_123)
    PAY -> K : same TX: payment = SUCCEEDED\n+ PaymentSucceeded
    CK --> C : 200 PAID, order confirming
  else declined
    PSP --> PAY : FAILED (card_declined)
    PAY -> K : same TX: payment = FAILED\n+ PaymentFailed
    CK --> C : 402 PAYMENT_FAILED
  else timeout / connection reset
    PAY -> PAY : status = UNKNOWN (never guess)
    CK --> C : 202 PAYMENT_PROCESSING
    loop reconciler, every 30 s
      PAY -> PSP : GET /charges?idempotency_key=pay_{reservationId}
      alt PSP has a record
        PSP --> PAY : SUCCEEDED or FAILED
        PAY -> K : record result + event
      else PSP has no record
        PAY -> PSP : retry charge with the SAME key (safe)
      end
    end
  end
end
== asynchronous consumers (idempotent) ==
K -> INV : PaymentSucceeded → CONFIRMED\nreserved - 1, sold + 1
K -> INV : PaymentFailed → PAYMENT_FAILED → RELEASED\navailable + 1, gate token + 1

@enduml
