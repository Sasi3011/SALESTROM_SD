title Sequence — Order creation and recovery\n(payment succeeded, Order Service down for 30 s)
autonumber
participant "Payment\nservice" as PAY
database "Payment DB\n(+ outbox)" as PDB
participant "Outbox relay\n(CDC)" as RL
queue "Kafka topic\nkey = reservationId" as K
participant "Order\nservice" as ORD
database "Order DB" as ODB
queue "Dead-letter\ntopic" as DLQ
participant "Reconciler" as REC
participant "Notification" as N

PAY -> PDB : BEGIN; payment = SUCCEEDED;\nINSERT outbox PaymentSucceeded; COMMIT
RL -> PDB : read WAL
RL -> K : publish PaymentSucceeded (acks = all)
note over ORD #FDECEF : Order Service DOWN (30 s)
K -> ORD : deliver
ORD -[#C8334F]x K : 503 — offset NOT committed
loop backoff 100 ms → 200 ms → … max 5 s (up to 25 attempts)
  K -> ORD : redeliver same message\n(order per key preserved)
end
note over ORD #E6F4EE : Order Service recovered
K -> ORD : CheckoutStarted, then PaymentSucceeded
ORD -> ODB : INSERT orders ON CONFLICT (reservation_id) DO NOTHING
ORD -> ODB : UPDATE orders SET status = 'CONFIRMED'\nWHERE reservation_id = ? AND status = 'PAYMENT_PENDING'
ORD -> ODB : INSERT outbox OrderConfirmed (same TX)
ORD -> K : commit offset
K -> N : OrderConfirmed → email + SMS
alt retries exhausted (poison message / very long outage)
  ORD -> DLQ : move message with error
  REC -> DLQ : replay when Order Service healthy
end
alt order cannot be fulfilled
  ORD -> K : OrderCancelled → Payment refunds (compensation)
end
note over PAY, N
  No paid order is lost: (1) payment + event commit atomically,
  (2) Kafka retains the event, (3) consumer is idempotent,
  (4) reconciler alerts on any "paid without order".
end note

@enduml
